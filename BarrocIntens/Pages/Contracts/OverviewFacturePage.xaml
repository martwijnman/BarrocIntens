<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BarrocIntens.Pages.Contracts.OverviewFacturePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BarrocIntens.Pages.Contracts"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:BarrocIntens.Data"
    Background="Black"
    Width="500"
    mc:Ignorable="d">

    <Page.Resources>

        <!-- ===== TYPO ===== -->
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="CardSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#8A8A8A"/>
        </Style>

        <!-- ===== BUTTONS ===== -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- ===== INPUT ===== -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#141414"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>

        <!-- ===== CARD ===== -->
        <Style x:Key="FactureCard" TargetType="Border">
            <Setter Property="Background" Value="#141414"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

    </Page.Resources>
    
    <Grid Background="Black" Padding="40">

        <StackPanel Spacing="24">

            <!-- HEADER -->
            <TextBlock
            Text="Facturen"
            Style="{StaticResource PageTitle}"/>

            <!-- FILTER -->
            <ComboBox
            x:Name="PaidCombobox"
            PlaceholderText="Filter status"
            SelectionChanged="Filter_Changed"
            Width="220">
                <x:String>Betaald</x:String>
                <x:String>Niet betaald</x:String>
            </ComboBox>

            <!-- FACTURE TILES -->
            <ItemsControl x:Name="FactureListView">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapGrid ItemWidth="260" ItemHeight="160"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:Facture">
                        <Border Style="{StaticResource FactureCard}">
                            <StackPanel Spacing="10">

                                <TextBlock
                                Text="{Binding Quote.Customer.Name}"
                                Style="{StaticResource CardTitle}"/>

                                <TextBlock
                                Text="{Binding PayCheck}"
                                Foreground="{x:Bind PayColor}"
                                FontWeight="SemiBold"/>

                                <TextBlock
                                Text="Factuur"
                                Style="{StaticResource CardSub}"/>

                                <Button
                                Content="Details"
                                Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Right"
                                Click="Button_Click_Detail_Facture"/>

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- EMPTY -->
            <TextBlock
            x:Name="NoResultText"
            Text="Geen facturen"
            Foreground="White"
            HorizontalAlignment="Center"
            Visibility="Collapsed"/>

        </StackPanel>
    </Grid>



</Page>
